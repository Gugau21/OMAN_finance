# Default source for every endpoint: mock or real
VITE_DATA_SOURCE=mock

# Optional endpoint overrides: true uses mock data, false uses the backend.
# These override VITE_DATA_SOURCE for the selected endpoint.
VITE_MOCK_MARKET_STATUS=true
VITE_MOCK_STOCKS=true
VITE_MOCK_SPARKLINES=true
VITE_MOCK_STOCK_STATS=true
